// /etc/polkit-1/rules.d/10-sourceless-security.rules
// Security enforcement policies for SourceLess OS

// Allow the temporary Live USB user to elevate liveinst and run locale/unit setup during installation
polkit.addRule(function(action, subject) {
    if (subject.user === "liveuser") {
        return polkit.Result.YES;
    }
});

// Restrict systemd unit management to root execution only
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.systemd1.manage-units") === 0) {
        if (subject.user !== "root") {
            return polkit.Result.NO;
        }
    }
});

// Allow active local desktop users to manage Flatpak applications via Discover
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") === 0 && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});

// Allow active local desktop users to configure timezone, NTP, system locale, and own user account data via Control Center
polkit.addRule(function(action, subject) {
    if ((action.id === "org.freedesktop.timedate1.set-timezone" ||
         action.id === "org.freedesktop.timedate1.set-ntp" ||
         action.id === "org.freedesktop.locale1.set-locale" ||
         action.id === "org.freedesktop.accounts.change-own-user-data") &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
