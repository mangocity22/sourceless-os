// /etc/polkit-1/rules.d/10-sourceless-security.rules
// Security enforcement policies for Sourceless-OS

// Restrict systemd unit management to root execution only
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.systemd1.manage-units") === 0) {
        if (subject.user !== "root") {
            return polkit.Result.NO;
        }
    }
});

// Allow active local desktop users to manage Flatpak applications via Discover
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") === 0 && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});