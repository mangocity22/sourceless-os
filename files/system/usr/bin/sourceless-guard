#!/usr/bin/bash
# /usr/bin/sourceless-guard - Autonomous local security scanner

TARGET="$1"
[ -z "$TARGET" ] || [ ! -f "$TARGET" ] && exit 0

QUARANTINE_DIR="/var/quarantine"
mkdir -p "$QUARANTINE_DIR"
chmod 700 "$QUARANTINE_DIR"

IS_THREAT=0
THREAT_NAME=""

# 1. Expand all .yar rule files from the signatures directory
shopt -s nullglob
RULE_FILES=(/etc/sourceless/rules/*.yar)

if [ ${#RULE_FILES[@]} -gt 0 ]; then
    MATCH=$(yara -w "${RULE_FILES[@]}" "$TARGET" 2>/dev/null | head -n 1 | awk '{print $1}')
    if [ -n "$MATCH" ]; then
        IS_THREAT=1
        THREAT_NAME="$MATCH"
    fi
fi

# 2. Quarantine payload and dispatch desktop notification
if [ $IS_THREAT -eq 1 ]; then
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    BASENAME=$(basename "$TARGET")
    DEST="$QUARANTINE_DIR/${TIMESTAMP}_${BASENAME}.threat"

    # Neutralize execution permissions and relocate
    mv "$TARGET" "$DEST"
    chmod 000 "$DEST"

    # Route desktop alert to the owning user's active KDE Wayland session
    TARGET_USER=""
    if [[ "$TARGET" =~ ^/var/home/([^/]+)/ ]]; then
        TARGET_USER="${BASH_REMATCH[1]}"
    fi
    if [ -z "$TARGET_USER" ] || ! id "$TARGET_USER" >/dev/null 2>&1; then
        TARGET_USER=$(loginctl list-sessions --no-legend 2>/dev/null | awk 'NR==1 {print $3}')
    fi
    TARGET_USER="${TARGET_USER:-sourceless}"

    USER_ID=$(id -u "$TARGET_USER" 2>/dev/null || echo "1000")
    USER_BUS="unix:path=/run/user/${USER_ID}/bus"

    sudo -u "$TARGET_USER" \
        XDG_RUNTIME_DIR="/run/user/${USER_ID}" \
        DBUS_SESSION_BUS_ADDRESS="$USER_BUS" \
        notify-send -u critical -i dialog-warning \
            "SourceLess OS Guard" \
            "Threat Blocked!\nFile: ${BASENAME}\nRule: ${THREAT_NAME}\nMoved to quarantine." 2>/dev/null &

    # Asynchronously report quarantined threat to SourceLess Fleet Console
    (
        HWID_FILE="/etc/sourceless/enrolled_hwid"
        TOKEN_FILE="/etc/sourceless/certs/client.token"
        if [ -f "$HWID_FILE" ] && [ -f "$TOKEN_FILE" ]; then
            HWID_VAL="$(cat "$HWID_FILE" 2>/dev/null | tr -d '\r\n')"
            TOKEN_VAL="$(cat "$TOKEN_FILE" 2>/dev/null | tr -d '\r\n')"
            if [ -n "$HWID_VAL" ] && [ -n "$TOKEN_VAL" ]; then
                PAYLOAD=$(python3 -c 'import json, sys; print(json.dumps({"hwid": sys.argv[1], "filename": sys.argv[2], "rule": sys.argv[3], "path": sys.argv[4], "quarantine_path": sys.argv[5]}))' "$HWID_VAL" "$BASENAME" "$THREAT_NAME" "$TARGET" "$DEST" 2>/dev/null || true)
                [ -n "$PAYLOAD" ] && curl -s -m 5 -X POST "https://api.srcdev.site/api/client/yara_alert" \
                    -H "Content-Type: application/json" \
                    -H "X-Sourceless-Token: $TOKEN_VAL" \
                    -d "$PAYLOAD" >/dev/null 2>&1 || true
            fi
        fi
    ) &
fi