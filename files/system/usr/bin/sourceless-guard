#!/usr/bin/bash
# /usr/bin/sourceless-guard - Autonomous local scanner

TARGET="$1"
[ -z "$TARGET" ] || [ ! -f "$TARGET" ] && exit 0

QUARANTINE_DIR="/var/quarantine"
mkdir -p "$QUARANTINE_DIR"
chmod 700 "$QUARANTINE_DIR"

RULES_DIR="/etc/sourceless/rules"
IS_THREAT=0
THREAT_NAME=""

# 1. Scanare locală ultra-rapidă prin YARA
if [ -d "$RULES_DIR" ]; then
    MATCH=$(yara -w -r "$RULES_DIR" "$TARGET" 2>/dev/null | head -n 1 | awk '{print $1}')
    if [ -n "$MATCH" ]; then
        IS_THREAT=1
        THREAT_NAME="$MATCH"
    fi
fi

# 2. Carantinare imediată și notificare desktop nativă
if [ $IS_THREAT -eq 1 ]; then
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    BASENAME=$(basename "$TARGET")
    DEST="$QUARANTINE_DIR/${TIMESTAMP}_${BASENAME}.threat"

    # Neutralizare completă
    mv "$TARGET" "$DEST"
    chmod 000 "$DEST"

    # Notificare grafică în sesiunea activă KDE Wayland
    USER_ID=$(id -u sourceless 2>/dev/null || echo "1000")
    USER_BUS="unix:path=/run/user/${USER_ID}/bus"
    
    sudo -u sourceless \
        XDG_RUNTIME_DIR="/run/user/${USER_ID}" \
        DBUS_SESSION_BUS_ADDRESS="$USER_BUS" \
        notify-send -u critical -i dialog-warning \
            "Sourceless-OS Guard" \
            "Amenințare blocată!\nFișier: ${BASENAME}\nSemnătură: ${THREAT_NAME}\nFișierul a fost mutat în /var/quarantine/." 2>/dev/null &
fi