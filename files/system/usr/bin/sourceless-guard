#!/usr/bin/bash
# /usr/bin/sourceless-guard - Ultra-lightweight threat checker

TARGET="$1"
[ -z "$TARGET" ] || [ ! -f "$TARGET" ] && exit 0

QUARANTINE_DIR="/var/quarantine"
mkdir -p "$QUARANTINE_DIR"
chmod 700 "$QUARANTINE_DIR"

IS_THREAT=0
THREAT_NAME=""

# 1. Cloud Reputation via MalwareBazaar (abuse.ch)
FILE_HASH=$(sha256sum "$TARGET" | awk '{print $1}')
MB_RESP=$(curl -s --max-time 3 -X POST https://mb-api.abuse.ch/api/v1/ \
    -d "query=get_info" \
    -d "hash=${FILE_HASH}" 2>/dev/null)

MB_STATUS=$(echo "$MB_RESP" | jq -r '.query_status // empty' 2>/dev/null)
if [ "$MB_STATUS" = "ok" ]; then
    IS_THREAT=1
    SIG=$(echo "$MB_RESP" | jq -r '.data[0].signature // "Known Threat"' 2>/dev/null)
    THREAT_NAME="MalwareBazaar: ${SIG}"
fi

# 2. Neutralizare și Carantină
if [ $IS_THREAT -eq 1 ]; then
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    BASENAME=$(basename "$TARGET")
    SAFE_NAME="${TIMESTAMP}_${BASENAME}.threat"
    DEST="$QUARANTINE_DIR/$SAFE_NAME"

    mv "$TARGET" "$DEST"
    chmod 000 "$DEST"

    USER_ID=$(id -u sourceless 2>/dev/null || echo "1000")
    USER_BUS="unix:path=/run/user/${USER_ID}/bus"
    sudo -u sourceless DBUS_SESSION_BUS_ADDRESS="$USER_BUS" \
        kdialog --title "Sourceless-OS Security" \
                --sorry "Threat Blocked!\n\nFile: ${BASENAME}\nVerdict: ${THREAT_NAME}\n\nThe file was safely moved to quarantine." 2>/dev/null &
fi