#!/usr/bin/bash
# /usr/bin/sourceless-sandbox - Anti-Infostealer bubblewrap runtime

RAW_CMD="$1"
shift

if [ -z "$RAW_CMD" ]; then
    echo "Usage: sourceless-sandbox <executable> [args...]"
    exit 1
fi

TARGET_APP=$(command -v "$RAW_CMD" 2>/dev/null || echo "$RAW_CMD")

if [ ! -e "$TARGET_APP" ]; then
    echo "Error: Executable '$RAW_CMD' not found."
    exit 1
fi

exec bwrap \
    --ro-bind / / \
    --dev /dev \
    --proc /proc \
    --tmpfs /tmp \
    --bind "$HOME" "$HOME" \
    --bind /run/user/"$(id -u)" /run/user/"$(id -u)" \
    --tmpfs "$HOME/.ssh" \
    --tmpfs "$HOME/.gnupg" \
    --tmpfs "$HOME/.local/share/keyrings" \
    --tmpfs "$HOME/.config/google-chrome" \
    --tmpfs "$HOME/.config/chromium" \
    --tmpfs "$HOME/.config/BraveSoftware" \
    --tmpfs "$HOME/.mozilla" \
    --tmpfs "$HOME/.electrum" \
    --tmpfs "$HOME/.bitcoin" \
    --tmpfs "$HOME/.solana" \
    --tmpfs "$HOME/.config/Sourceless" \
    "$TARGET_APP" "$@"