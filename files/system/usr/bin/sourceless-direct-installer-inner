#!/usr/bin/bash
# /usr/bin/sourceless-direct-installer-inner
# Monitors native liveinst execution inside the Plasma session and reboots after a completed run.
set -uo pipefail

export LANG="${LANG:-en_US.UTF-8}"

START_TS=$(date +%s)

# Wait up to 8s for native liveinst.desktop autostart to bring up the installer
FOUND=0
for _ in {1..16}; do
    if pgrep -f "/usr/bin/liveinst|/usr/libexec/anaconda/webui-desktop|/usr/bin/slitherer|/usr/sbin/anaconda|/usr/bin/anaconda" >/dev/null 2>&1; then
        FOUND=1
        break
    fi
    sleep 0.5
done

# Start liveinst as liveuser if systemd/xdg-autostart did not launch it yet
if [ "$FOUND" -eq 0 ]; then
    /usr/bin/liveinst >/tmp/sourceless-liveinst.log 2>&1 || true
fi

# Wait while any installer or WebUI process remains active
while pgrep -f "/usr/bin/liveinst|/usr/libexec/anaconda/webui-desktop|/usr/bin/slitherer|/usr/sbin/anaconda|/usr/bin/anaconda" >/dev/null 2>&1; do
    sleep 1
done

ELAPSED=$(( $(date +%s) - START_TS ))

# Only reboot after a genuine interactive installer session (>= 15s) to prevent boot loops
if [ "$ELAPSED" -ge 15 ]; then
    sudo /usr/bin/systemctl reboot 2>/dev/null || systemctl reboot 2>/dev/null || true
fi

exit 0
