#!/usr/bin/bash
# /usr/bin/sourceless-direct-installer
# Delegates standalone installer session cleanly to startplasma-wayland with fullscreen window rules.
set -uo pipefail

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export QT_QPA_PLATFORM=wayland
export LANG="${LANG:-en_US.UTF-8}"

USER_CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$USER_CFG"

# Enforce borderless fullscreen rules on normal application windows while allowing centered dialogs
cat << 'EOF' > "${USER_CFG}/kwinrulesrc"
[1]
Description=SourceLess Direct Installer Fullscreen
maximizehoriz=true
maximizehorizrule=2
maximizevert=true
maximizevertrule=2
noborder=true
noborderrule=2
types=1
wmclass=slitherer|anaconda|webui|liveinst
wmclasscomplete=false
wmclassmatch=3

[General]
count=1
rules=1
EOF

if [ -x /usr/libexec/plasma-dbus-run-session-if-needed ]; then
    exec /usr/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
else
    exec /usr/bin/startplasma-wayland
fi
